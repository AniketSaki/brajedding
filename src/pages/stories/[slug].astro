---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { starString, teaserFrom } from '../../lib/stories';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
---
<Base title={`${story.data.title} · Brajesh & Saranya`} description={story.data.teaser ?? teaserFrom(story.body ?? '')}>
  <header class="halftone-blue story-head">
    <div class="film-strip"></div>
    <div class="inner">
      <a class="back label" href="/#reviews">← Back to the premiere</a>
      <h1 class="misprint">{story.data.title}</h1>
      <p class="meta"><span aria-label={`${story.data.rating} out of 5 stars`}>{starString(story.data.rating)}</span> · by {story.data.author}</p>
    </div>
  </header>
  <main class="section">
    <article class="panel prose"><Content /></article>
    <p class="back-bottom"><a class="btn" href="/#reviews">← Back to the premiere</a></p>
  </main>
</Base>

<style>
  .story-head { border-bottom: 4px solid var(--ink); }
  .inner { max-width: 760px; margin: 0 auto; padding: 1.5rem 1.25rem 1.75rem; }
  .back { color: var(--white); text-decoration: none; }
  h1 {
    font-family: var(--display); font-weight: 400; font-size: clamp(2.4rem, 10vw, 4rem); line-height: 0.95;
    text-transform: uppercase; transform: rotate(-1.5deg); margin: 1rem 0 0.5rem;
  }
  .meta { margin: 0; color: var(--yellow); font-weight: 700; }
  .prose { max-width: 760px; margin: 0 auto; padding: 1.25rem 1.4rem; font-size: 1.08rem; line-height: 1.65; }
  .prose :global(h2), .prose :global(h3) { font-family: var(--display); font-weight: 400; letter-spacing: 0.03em; font-size: 1.7rem; margin: 1.4rem 0 0.4rem; }
  .prose :global(p) { max-width: 65ch; }
  .prose :global(a) { color: var(--blue); }
  .prose :global(img) { border: 3px solid var(--ink); margin: 1rem 0; }
  .back-bottom { max-width: 760px; margin: 1.5rem auto 0; }
  .back-bottom .btn { text-decoration: none; }
</style>
