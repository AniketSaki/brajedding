---
import { getCollection } from 'astro:content';
import { teaserFrom, starString, sortStories } from '../lib/stories';

const stories = sortStories(await getCollection('stories'));
---
{stories.length > 0 && (
  <section class="section reviews" id="reviews" aria-labelledby="reviews-h">
    <h2 class="tab" id="reviews-h">Reviews</h2>
    <div class="cards">
      {stories.map((s) => (
        <article class="panel card">
          <h3><a href={`/stories/${s.id}/`}>{s.data.title}</a></h3>
          <p class="meta">
            <span aria-label={`${s.data.rating} out of 5 stars`}>{starString(s.data.rating)}</span> · by {s.data.author}
          </p>
          <p class="teaser">
            {s.data.teaser ?? teaserFrom(s.body ?? '')}{' '}
            <a class="more" href={`/stories/${s.id}/`} aria-label={`Read more: ${s.data.title}`}>read more</a>
          </p>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .cards { display: grid; gap: 1.1rem; }
  @media (min-width: 768px) { .cards { grid-template-columns: 1fr 1fr; gap: 1.4rem; } }
  .card:nth-child(odd) { transform: rotate(-0.6deg); }
  .card:nth-child(even) { transform: rotate(0.6deg); }
  h3 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 1.6rem; letter-spacing: 0.03em; text-transform: uppercase; line-height: 1.05; }
  h3 a { color: inherit; text-decoration: none; }
  .meta { margin: 0.3rem 0 0.6rem; color: var(--pink); font-weight: 700; font-size: 0.85rem; }
  .teaser { margin: 0; color: #333; }
  .more { color: var(--ink); font-weight: 700; }
</style>
