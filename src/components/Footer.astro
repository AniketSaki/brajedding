---
import { site } from '../config/site';
---
<footer>
  <div class="film-strip"></div>
  <p>{site.footer}</p>
</footer>

<style>
  footer { margin-top: 2rem; background: var(--ink); color: var(--yellow); }
  p { margin: 0; padding: 1.4rem 1rem 1.6rem; text-align: center; font-family: var(--display); font-size: 1.35rem; letter-spacing: 0.05em; }
</style>
