---
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import captions from '../data/captions.json';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/stills/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}', {
  eager: true,
});
const capMap = captions as Record<string, string>;

const stills = await Promise.all(
  Object.keys(files)
    .sort()
    .map(async (path) => {
      const name = path.split('/').pop()!;
      const src = files[path].default;
      const full = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' });
      return { name, src, full: full.src, caption: capMap[name] ?? '' };
    }),
);
---
{stills.length > 0 && (
  <section class="section stickered" aria-labelledby="stickered-h">
    <h2 class="tab" id="stickered-h">Stickered</h2>
    <ul class="grid">
      {stills.map((s, i) => (
        <li class="sticker">
          <button type="button" class="open" data-index={i} data-full={s.full} aria-label={`Open photo ${i + 1}${s.caption ? `: ${s.caption}` : ''}`}>
            <Picture
              src={s.src}
              formats={['avif', 'webp']}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 90vw"
              alt={s.caption || `Brajesh, photo ${i + 1}`}
              loading="lazy"
            />
          </button>
          {s.caption && <p class="caption">{s.caption}</p>}
        </li>
      ))}
    </ul>

    <dialog class="lightbox" aria-label="Photo viewer">
      <button type="button" class="lb-close" aria-label="Close">✕</button>
      <button type="button" class="lb-nav lb-prev" aria-label="Previous photo">‹</button>
      <figure><img alt="" /><figcaption></figcaption></figure>
      <button type="button" class="lb-nav lb-next" aria-label="Next photo">›</button>
    </dialog>
  </section>
)}

<script>
  const root = document.querySelector<HTMLElement>('.stickered');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.open')];
    const dlg = root.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    let idx = 0;

    const show = (i: number) => {
      idx = (i + buttons.length) % buttons.length;
      const b = buttons[idx];
      img.src = b.dataset.full!;
      img.alt = b.querySelector('img')?.alt ?? '';
      cap.textContent = b.closest('li')?.querySelector('.caption')?.textContent ?? '';
    };

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        show(i);
        dlg.showModal();
      }),
    );
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    let startX = 0;
    dlg.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
    });
    if (buttons.length < 2) dlg.querySelectorAll<HTMLElement>('.lb-nav').forEach((n) => (n.hidden = true));
  }
</script>

<style>
  .grid {
    list-style: none; margin: 0; padding: 0.5rem 1.25rem 0;
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, 1fr); padding: 0.5rem 0 0; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(4, 1fr); } }

  .sticker { position: relative; transform: rotate(-2.5deg); }
  .sticker:nth-child(even) { transform: rotate(2.5deg); }
  .sticker::before {
    content: ''; position: absolute; z-index: 2; top: -12px; left: 38%; width: 72px; height: 22px;
    background: rgba(0, 229, 255, 0.6); transform: rotate(-6deg);
  }
  .sticker:nth-child(even)::before { left: 22%; transform: rotate(5deg); background: rgba(255, 79, 154, 0.55); }

  .open {
    display: block; width: 100%; padding: 9px; border: 0; cursor: zoom-in;
    background: var(--white); border-radius: 16px;
    box-shadow: 0 0 0 2px var(--ink), 6px 7px 0 2px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s;
  }
  .open:hover { transform: scale(1.02) rotate(-1deg); }
  .open :global(img) { width: 100%; height: auto; border-radius: 9px; }
  .caption {
    margin: 0.6rem 0 0; text-align: center; font-family: var(--display); font-size: 1.2rem; letter-spacing: 0.03em;
  }

  .lightbox {
    max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; margin: 0; padding: 0;
    border: 0; background: rgba(17, 17, 17, 0.94); color: var(--white);
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.6); }
  .lightbox figure { margin: 0; max-width: min(92vw, 1100px); }
  .lightbox img { max-height: 82dvh; width: auto; margin: 0 auto; border: 6px solid var(--white); border-radius: 10px; }
  .lightbox figcaption { text-align: center; margin-top: 0.6rem; font-family: var(--display); font-size: 1.3rem; }
  .lb-close, .lb-nav {
    position: fixed; background: var(--yellow); color: var(--ink); border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--pink); font-size: 1.6rem; width: 46px; height: 46px; cursor: pointer; line-height: 1;
  }
  .lb-close { top: 14px; right: 14px; }
  .lb-prev { left: 10px; top: 50%; }
  .lb-next { right: 10px; top: 50%; }
</style>
