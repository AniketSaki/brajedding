---
import { site } from '../config/site';
---
<div class="shout-wrap" role="note">
  <div class="burst" aria-hidden="true"></div>
  <p class="shout">{site.shout}</p>
</div>

<style>
  .shout-wrap {
    position: relative; display: grid; place-items: center;
    width: min(88vw, 420px); aspect-ratio: 1.6; margin: 0.5rem auto 1rem; transform: rotate(-5deg);
  }
  .burst, .burst::after { position: absolute; inset: 0; }
  /* Jagged comic "shout" outline: black spikes behind a white fill */
  .burst {
    background: var(--ink);
    clip-path: polygon(50% 0%, 58% 14%, 72% 2%, 74% 18%, 92% 10%, 86% 28%, 100% 32%, 88% 46%, 100% 58%, 86% 64%, 96% 82%, 76% 78%, 72% 98%, 60% 84%, 50% 100%, 40% 84%, 28% 98%, 24% 78%, 4% 84%, 14% 64%, 0% 58%, 12% 46%, 0% 32%, 14% 28%, 8% 10%, 26% 18%, 28% 2%, 42% 14%);
    filter: drop-shadow(5px 5px 0 var(--pink));
  }
  .burst::after {
    content: ''; inset: 7px; background: var(--white);
    clip-path: inherit;
  }
  .shout {
    position: relative; margin: 0; padding: 0 22%; text-align: center;
    font-family: var(--display); font-size: clamp(1.35rem, 6vw, 1.9rem); line-height: 1.05;
    letter-spacing: 0.03em; text-transform: uppercase; color: var(--ink);
  }
</style>
